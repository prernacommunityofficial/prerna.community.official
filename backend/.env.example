PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/prerna
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
INITIAL_ADMIN_NAME=Prerna Admin
INITIAL_ADMIN_EMAIL=admin@prerna.org
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-google-account@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=PRERNA Community <your-google-account@gmail.com>

